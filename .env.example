# Environment variable template for E-commerce Order Lifecycle and Event Processing.
#
# Copy this file to `.env` only if local overrides are needed.
# NEVER commit real credentials or secrets.

# ---------------------------------------------------------------------------
# Kafka connection for host-side producers and consumers
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------------------------------------------------------------------------
# Consumer topics
# ---------------------------------------------------------------------------
KAFKA_STATE_TOPIC=ecommerce.order-lifecycle.state
KAFKA_PROCESSED_TOPIC=ecommerce.order-lifecycle.processed
KAFKA_EXCEPTIONS_TOPIC=ecommerce.order-lifecycle.exceptions

# ---------------------------------------------------------------------------
# Independent consumer group IDs
# ---------------------------------------------------------------------------
KAFKA_STATE_CONSUMER_GROUP=order-lifecycle-state-consumer
KAFKA_PROCESSED_CONSUMER_GROUP=order-lifecycle-processed-consumer
KAFKA_EXCEPTIONS_CONSUMER_GROUP=order-lifecycle-exceptions-consumer

# ---------------------------------------------------------------------------
# Optional security settings for non-local Kafka
# ---------------------------------------------------------------------------
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Flink connection
# ---------------------------------------------------------------------------
FLINK_JOBMANAGER_REST_URL=http://localhost:18081

# ---------------------------------------------------------------------------
# Optional processing-rules override for the Flink job
# ---------------------------------------------------------------------------
ORDER_LIFECYCLE_PROCESSING_RULES=
