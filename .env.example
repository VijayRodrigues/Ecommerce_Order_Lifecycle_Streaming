# Environment variable template for E-commerce Order Lifecycle and Event Processing.
#
# Copy this file to `.env` and fill in values locally.
# NEVER commit real credentials or secrets.
# No real credentials belong in this template.

# ---------------------------------------------------------------------------
# Kafka connection
# ---------------------------------------------------------------------------
# TODO: Set the Kafka bootstrap server address used by this project.
KAFKA_BOOTSTRAP_SERVERS=

# TODO: Set the consumer group identifier for this project only.
KAFKA_CONSUMER_GROUP=

# TODO: Set the security protocol only if required by the environment.
KAFKA_SECURITY_PROTOCOL=

# TODO: Provide SASL credentials locally only if required.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------------------------------------------------------------------------
# Flink connection
# ---------------------------------------------------------------------------
# TODO: Set the Flink JobManager REST address for job submission.
FLINK_JOBMANAGER_REST_URL=

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
# TODO: Set the runtime environment name (for example, local).
APP_ENVIRONMENT=

# TODO: Set the log level.
APP_LOG_LEVEL=
